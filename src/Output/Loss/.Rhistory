library("grid")
library("DescTools")
library("rjson")
setwd("C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/")
source("AUC.R")
setwd("C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/Output/Loss/")
varvec = as.character(c(0.5))
newMI = paste(varvec, "MI", sep = "")
newIC = paste(varvec, "IC", se = "")
title = "Information loss in MI-encoding population and IC-encoding population after Generations of Mutations"
jsonParameters = fromJSON(file = "C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/settings.json" )
MutationRate = 0.01
subtitle = "95% confidence intervals using Standard Error of the Mean are visualized through the shaded area"
xlab = "# Generations of Mutations"
ylab = "Information (Bits)"
filename = "/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/Output/Figures/Paper/Figure2_part1.png"
lossdf = list()
graphs = list()
maxInformation = 0
#Adds all 4 strategies to lossdf list as a dataframe and updates maxInformation as largest amount of information
for (var in varvec){
#lossdf[[as.character(var)]] = read.csv(paste("./ConstrictOneModeInformation/population_100_100_5_0.5_", var, "IC_MImode.csv", sep = ""))
lossdf[[newIC]] = read.csv(paste("./Paper/Figure_2/population_100_128_2_1bit_", newIC, ".csv", sep = ""))
lossdf[[newMI]] = read.csv(paste("./Paper/Figure_2/population_100_128_2_1bit_", newMI, ".csv", sep = ""))
colnames(lossdf[[newIC]]) <- c("Generation", "IC", "MI", "TI", "SEM_IC", "SEM_MI", "SEM_TI")
colnames(lossdf[[newMI]]) <- c("Generation", "IC", "MI", "TI", "SEM_IC", "SEM_MI", "SEM_TI")
#colnames(lossdf[[as.character(var)]]) <- c("Generation", "KLD")
if (lossdf[[newIC]]$TI[1] > lossdf[[newIC]]$TI[1]){
highestInformation = lossdf[[newIC]]$TI[1]
} else {
highestInformation = lossdf[[newMI]]$TI[1]
}
if (highestInformation > maxInformation){
maxInformation = highestInformation
}
}
library("ggplot2")
library("patchwork")
library("gridExtra")
library("grid")
library("DescTools")
library("rjson")
setwd("C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/")
source("AUC.R")
setwd("C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/Output/Loss/")
varvec = as.character(c(0.5))
newMI = paste(varvec, "MI", sep = "")
newIC = paste(varvec, "IC", sep = "")
title = "Information loss in MI-encoding population and IC-encoding population after Generations of Mutations"
jsonParameters = fromJSON(file = "C:/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/settings.json" )
MutationRate = 0.01
subtitle = "95% confidence intervals using Standard Error of the Mean are visualized through the shaded area"
xlab = "# Generations of Mutations"
ylab = "Information (Bits)"
filename = "/Users/thele/OneDrive/Documents/Anaconda/envs/IT_TF/src/Output/Figures/Paper/Figure2_part1.png"
lossdf = list()
graphs = list()
maxInformation = 0
#Adds all 4 strategies to lossdf list as a dataframe and updates maxInformation as largest amount of information
for (var in varvec){
#lossdf[[as.character(var)]] = read.csv(paste("./ConstrictOneModeInformation/population_100_100_5_0.5_", var, "IC_MImode.csv", sep = ""))
lossdf[[newIC]] = read.csv(paste("./Paper/Figure_2/population_100_128_2_1bit_", newIC, ".csv", sep = ""))
lossdf[[newMI]] = read.csv(paste("./Paper/Figure_2/population_100_128_2_1bit_", newMI, ".csv", sep = ""))
colnames(lossdf[[newIC]]) <- c("Generation", "IC", "MI", "TI", "SEM_IC", "SEM_MI", "SEM_TI")
colnames(lossdf[[newMI]]) <- c("Generation", "IC", "MI", "TI", "SEM_IC", "SEM_MI", "SEM_TI")
#colnames(lossdf[[as.character(var)]]) <- c("Generation", "KLD")
if (lossdf[[newIC]]$TI[1] > lossdf[[newIC]]$TI[1]){
highestInformation = lossdf[[newIC]]$TI[1]
} else {
highestInformation = lossdf[[newMI]]$TI[1]
}
if (highestInformation > maxInformation){
maxInformation = highestInformation
}
}
ICsemMAX = lossdf[[newIC]]$IC + 2*lossdf[[newIC]]$SEM_IC
ICsemMIN = lossdf[[newIC]]$IC - 2*lossdf[[newIC]]$SEM_IC
MIsemMAX = lossdf[[newMI]]$MI + 2*lossdf[[newMI]]$SEM_MI
MIsemMIN = lossdf[[newMI]]$MI - 2*lossdf[[newMI]]$SEM_MI
hybridDataFrame = data.frame(Generation = lossdf[[newIC]]$Generation, IC = lossdf[[newIC]]$IC, MI = lossdf[[newMI]]$MI, ICsemMAX, ICsemMIN, MIsemMAX, MIsemMIN)
#Iterates through lossdf and adds ggplots for each df to graphs
var1 <- ggplot(hybridDataFrame) + geom_line(aes(x = Generation, y = IC, colour = "IC")) + geom_line(aes(x = Generation, y = MI, colour = "MI")) + scale_color_manual(values = c("red", "blue")) + labs(colour = "Information Encoding Strategy") + ylim(0,maxInformation)
var1 = var1 + geom_ribbon(aes(x = Generation, ymax = ICsemMAX, ymin = ICsemMIN), alpha = 0.25, fill = "red")
var1 = var1 + geom_ribbon(aes(x = Generation, ymax = MIsemMAX, ymin = MIsemMIN), alpha = 0.25, fill = "blue")
var1 = var1 + xlab("# of Generations of Mutation") + ylab("Information (bits)")
finalGraph = var1 + plot_annotation(title = title, subtitle = subtitle) + theme_bw()
#Finds asymptote
asymptotevec <- list()
asymptotevec[[newIC]] = AUC_InformationCurve(hybridDataFrame$Generation, hybridDataFrame$IC)
asymptotevec[[newMI]] = AUC_InformationCurve(hybridDataFrame$Generation, hybridDataFrame$MI)
#Computes asymptote AUC as #num generations * min(Value)
oneICAUC = asymptotevec[[newIC]]$AUCval - (max(lossdf[[newIC]]$Generation) * asymptotevec[[newIC]]$TIasym)
oneMIAUC = asymptotevec[[newMI]]$AUCval - (max(lossdf[[newMI]]$Generation) * asymptotevec[[newMI]]$TIasym)
finalGraph = finalGraph + annotate("label", x = 250, y = 0.95, label = paste("IC curve AUC:", round(oneICAUC, digits = 2)))
finalGraph + annotate("label", x = 250, y = 0.86, label = paste("MI curve AUC:", round(oneMIAUC, digits = 2)))
ggsave(filename, scale = 1.25)
finalGraph = finalGraph + annotate("label", x = 250, y = 0.95, label = paste("IC curve AUC:", round(oneICAUC, digits = 2)))
finalGraph
round(oneICAUC, digits = 2)
